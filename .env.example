# Copie para `.env` e ajuste antes de subir a stack.
# Gere cada segredo com: python -c "import secrets; print(secrets.token_urlsafe(48))"

ENVIRONMENT=dev

POSTGRES_DB=lims
POSTGRES_USER=lims
POSTGRES_PASSWORD=lims
POSTGRES_PORT=5432

# Substitua em qualquer ambiente compartilhado.
JWT_SECRET=dev-insecure-jwt-secret-change-me-please-32bytes
AUDIT_HMAC_KEY=dev-insecure-audit-hmac-key-change-me-32bytes
QR_SIGNING_KEY=dev-insecure-qr-signing-key-change-me-32bytes

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_HOURS=12
ESIGNATURE_TTL_SECONDS=300
SESSION_IDLE_TIMEOUT_MINUTES=15
AUTO_OPEN_CAPA_ON_FAILURE=true
# Em produção o schema é aplicado pelo serviço `migrate` (Alembic).
AUTO_CREATE_SCHEMA=false

# Exportação assinada da trilha
AUDIT_EXPORT_MAX_RECORDS=50000
AUDIT_EXPORT_MAX_BYTES=26214400

# Rate limiting (por processo; <= 0 desabilita)
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW_SECONDS=60
SIGN_RATE_LIMIT=20
SIGN_RATE_WINDOW_SECONDS=60

API_PORT=8000
WEB_PORT=8080
CORS_ORIGINS=http://localhost:8080
