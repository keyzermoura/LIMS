# Copie para .env e ajuste. NUNCA versione segredos reais.
ENVIRONMENT=dev
DEBUG=false

# Banco
DATABASE_URL=postgresql+asyncpg://lims:lims@localhost:5432/lims
DB_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Segredos — gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-jwt-secret-change-me-please-32bytes
AUDIT_HMAC_KEY=dev-insecure-audit-hmac-key-change-me-32bytes
QR_SIGNING_KEY=dev-insecure-qr-signing-key-change-me-32bytes

# Sessão
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_HOURS=12
ESIGNATURE_TTL_SECONDS=300
SESSION_IDLE_TIMEOUT_MINUTES=15

# Política
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Negócio
AUTO_OPEN_CAPA_ON_FAILURE=true
AUTO_CREATE_SCHEMA=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
